# ── Приложение ────────────────────────────────────────────────────────────────
APP_BIND=0.0.0.0
APP_PORT=8000
DATA_DIR=/data
HF_HOME=/models
LOG_LEVEL=info
IMAGE_TAG=latest
GIT_SHA=
TZ=Europe/Moscow

# ── ASR ──────────────────────────────────────────────────────────────────────
# gigaam-v3-e2e-rnnt (точнее) | gigaam-v3-e2e-ctc (быстрее)
ASR_MODEL=gigaam-v3-e2e-rnnt
# Список моделей, доступных для выбора в UI (через запятую)
ASR_AVAILABLE_MODELS=gigaam-v3-e2e-rnnt,gigaam-v3-e2e-ctc
# cuda | cpu
ASR_DEVICE=cuda
# Пусто = автоматически: None для CUDA, int8 для CPU
ASR_QUANT=
ASR_BATCH=8
# onnx | fake (fake — только для тестов/CI)
ASR_BACKEND=onnx
HF_HUB_OFFLINE=0

# ── VAD / потоковая обработка ────────────────────────────────────────────────
ASR_VAD_THRESHOLD=0.5
ASR_VAD_MIN_SPEECH_MS=250
ASR_VAD_MAX_SPEECH_S=20
ASR_VAD_MIN_SILENCE_MS=300
ASR_VAD_SPEECH_PAD_MS=100
# Размер блока чтения WAV для VAD, секунды (не влияет на качество)
ASR_STREAM_CHUNK_S=60

# ── Лимиты и хранение ───────────────────────────────────────────────────────
MAX_UPLOAD_MB=2048
MAX_DURATION_MIN=180
QUEUE_MAX=20
RESULT_TTL_HOURS=24
DOCX_TIMESTAMPS=false
UPLOAD_RATE_LIMIT_PER_MIN=5
WORKER_STALE_SECONDS=90
WORKER_POLL_INTERVAL_S=0.5
WORKER_HEARTBEAT_S=5
MAX_CACHED_MODELS=2

# ── Безопасность ────────────────────────────────────────────────────────────
# Пусто = авторизация выключена. Для включения задайте длинный случайный токен.
AUTH_TOKEN=
# Доверять X-Forwarded-For только за известным реверс-прокси
TRUST_PROXY=false
ENABLE_HSTS=false
ALLOWED_HOSTS=*

# ── Docker / сборка ─────────────────────────────────────────────────────────
# База CUDA 12.8 + cuDNN 9. Для RTX 30xx/40xx можно взять 12.6.3 (тоже cuDNN 9).
# BASE_IMAGE=nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04
BASE_IMAGE=nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04
# 1 = запечь веса в образ (air-gapped). По умолчанию 0.
PRELOAD_MODELS=0
# Лимиты памяти контейнеров (docker compose)
WEB_MEM_LIMIT=512m
WORKER_MEM_LIMIT=6g

# ── Опциональный профиль proxy (Caddy) ──────────────────────────────────────
# Домен для автоматического TLS. localhost = внутренний самоподписанный сертификат.
PROXY_DOMAIN=localhost
PROXY_USER=admin
# Хеш bcrypt: caddy hash-password --plaintext 'ваш-пароль'
PROXY_PASSWORD_HASH=
